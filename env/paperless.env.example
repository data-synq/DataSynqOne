PAPERLESS_REDIS=redis://redis:6379

PAPERLESS_DBHOST=postgres
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=change-me

PAPERLESS_SECRET_KEY=change-me-too

# The admin user is created on first start only.
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_MAIL=admin@example.com
PAPERLESS_ADMIN_PASSWORD=change-me

PAPERLESS_URL=http://localhost
PAPERLESS_CSRF_TRUSTED_ORIGINS=http://localhost
PAPERLESS_TIME_ZONE=Europe/Berlin

PAPERLESS_OCR_LANGUAGES=deu eng
PAPERLESS_OCR_ROTATE_PAGES=true

PAPERLESS_INDEX_TASK_CRON="0 22 * * *"
PAPERLESS_FILENAME_FORMAT="{created_year}/{correspondent}/{document_type}/{created}-{title}"

# Owner of the bind mounts under data/paperless — set to your own `id -u` / `id -g`.
USERMAP_UID=1000
USERMAP_GID=1000
