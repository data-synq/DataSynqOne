# Host overrides for `make dev`, applied on top of backend.env.
# The backend runs natively there, so the Compose service names in backend.env
# (vectordb, paperless) do not resolve — these point at the published ports.
#
# Keep secrets out of this file; they stay in backend.env.

ENVIRONMENT=development
DATABASE_URL=postgresql://brain:change-me@localhost:5433/brain
PAPERLESS_BASE_URL=http://localhost

# The Vite dev proxy makes requests same-origin, so CORS never kicks in.
# Listed anyway for anyone who bypasses the proxy and calls :8001 directly.
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Dev serves plain http://localhost — a Secure cookie would never be stored there,
# and the login would look successful while every following request came back 401.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=dsq_session
SESSION_TTL_HOURS=12
SESSION_ABSOLUTE_TTL_HOURS=24

# Mailpit from compose.dev.yml swallows every mail and shows it at
# http://localhost:8025 — nothing ever reaches a real inbox in dev.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_FROM_EMAIL=one@datasynq.local

# The Vite dev server, so invitation links open the app you are working on.
APP_BASE_URL=http://localhost:5173
