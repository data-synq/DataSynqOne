ENVIRONMENT=production

PAPERLESS_BASE_URL=http://paperless:8000
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

CORS_ORIGINS=[]
APP_BASE_URL=https://one.example.org
# Must match only the Docker subnet through which Caddy reaches this backend.
TRUSTED_PROXY_CIDRS=["172.30.0.0/24"]
ADMIN_CLIENT_CIDRS=["10.20.0.0/24"]
MAX_REQUEST_BYTES=1048576
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT_SECONDS=30
APP_TIMEZONE=Europe/Berlin

ADMIN_EMAIL=admin@example.org
SESSION_COOKIE_NAME=__Host-dsq_session
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=12
SESSION_ABSOLUTE_TTL_HOURS=24
# Secret: /run/secrets/mfa_encryption_key

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_SECURITY=starttls
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=DataSynq One
SMTP_REPLY_TO=
SMTP_TIMEOUT_SECONDS=15
ALLOW_INSECURE_MAIL_TRANSPORT=false

INVITATION_TTL_HOURS=72
DEADLINE_DIGEST_ENABLED=true
DEADLINE_DIGEST_HOUR=7
DEADLINE_DIGEST_DAYS_AHEAD=14
DEADLINE_DIGEST_RECIPIENTS=[]

MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURITY=ssl
MAIL_IMAP_USERNAME=
MAIL_IMAP_FOLDER=INBOX
MAIL_RULE_TAGS=["correspondence"]

MAIL_INTAKE_ENABLED=false
MAIL_INGRESS_PREVALIDATED=false
MAIL_INTAKE_POLL_SECONDS=300
MAIL_INTAKE_MAX_CHARS=8000
MAIL_WHITELIST_TRUST_DAYS=21
