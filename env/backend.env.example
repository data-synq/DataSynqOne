# Container-facing backend configuration (used by `make up`).
# For `make dev` the host overrides in backend.dev.env are applied on top.

ENVIRONMENT=production
# This template intentionally does not start unchanged: replace every placeholder
# and the localhost public URLs before using it outside native development.

PAPERLESS_BASE_URL=http://paperless:8000
# Create in Paperless under Settings -> API Token.
PAPERLESS_API_TOKEN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

DATABASE_URL=postgresql://brain:change-me@vectordb:5432/brain
CORS_ORIGINS=["http://localhost:8080"]

# The first administrator, created only while no user account exists at all.
# Without both values nothing is created and nobody can sign in — there is no
# built-in default password. Change it right after the first login; the account
# is flagged to require exactly that.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Session cookie. Keep SESSION_COOKIE_SECURE=true wherever the app is served over
# HTTPS; `make dev` overrides it in backend.dev.env because it serves plain HTTP.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_NAME=__Host-dsq_session
SESSION_TTL_HOURS=12
SESSION_ABSOLUTE_TTL_HOURS=24

# Outgoing mail. An empty SMTP_HOST turns sending off entirely — the app stays
# fully usable, sends nothing and reports mail_sent: false. Invitation links then
# show up in the user management screen to be passed on by hand.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (587, the usual case) | tls (465, implicit) | none (local relay only)
SMTP_SECURITY=starttls
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=DataSynq One
SMTP_REPLY_TO=
SMTP_TIMEOUT_SECONDS=15
# Only for a trusted local relay in an otherwise production deployment.
ALLOW_INSECURE_MAIL_TRANSPORT=false

# The public URL of the frontend. Invitation and password-reset links are built
# from it, and the backend cannot discover it on its own — set it per deployment
# or every link a user receives points at localhost.
APP_BASE_URL=http://localhost:8080
INVITATION_TTL_HOURS=72

# Daily deadline reminder to every active administrator and editor. Nothing is
# sent on a day without open deadlines.
DEADLINE_DIGEST_ENABLED=true
DEADLINE_DIGEST_HOUR=7
DEADLINE_DIGEST_DAYS_AHEAD=14
# JSON list; empty means every active administrator and editor.
DEADLINE_DIGEST_RECIPIENTS=[]

# Incoming mail via Paperless's own mail fetcher (requires PAPERLESS_TIKA_ENABLED
# and the gotenberg/tika services, see compose.yml). An empty MAIL_IMAP_HOST or
# MAIL_IMAP_USERNAME turns this off entirely — no account or rule is created.
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
# ssl (993, implicit) | starttls (143) | none
MAIL_IMAP_SECURITY=ssl
MAIL_IMAP_USERNAME=
MAIL_IMAP_PASSWORD=
MAIL_IMAP_FOLDER=INBOX
# JSON list of existing Paperless tag names, applied to every incoming document.
MAIL_RULE_TAGS=["correspondence"]

# Intake of incoming correspondence into cases.
MAIL_INTAKE_ENABLED=true
MAIL_INTAKE_POLL_SECONDS=300
MAIL_INTAKE_MAX_CHARS=8000
MAIL_WHITELIST_TRUST_DAYS=21
